 "human_notes": {
  "order": [
   {
    "note": "AE2 does not start at a crafting bench, it starts at WORLDGEN. Every guide's first instruction is to go find a meteorite, and the meteorite compass is the tool for it.",
    "ids": [
     "ae2:meteorite_compass",
     "ae2:mysterious_cube",
     "ae2:certus_quartz_crystal",
     "ae2:charged_certus_quartz_crystal"
    ]
   },
   {
    "note": "The presses inside the mysterious cube are the real prize of the meteorite - they are not craftable and everything downstream needs them.",
    "ids": [
     "ae2:silicon_press",
     "ae2:logic_processor_press",
     "ae2:calculation_processor_press",
     "ae2:engineering_processor_press",
     "ae2:inscriber"
    ]
   },
   {
    "note": "Certus growth is set up before any network: budding blocks plus growth accelerators are the sustainable supply.",
    "ids": [
     "ae2:flawless_budding_quartz",
     "ae2:growth_accelerator",
     "ae2:certus_quartz_crystal",
     "ae2:fluix_crystal"
    ]
   },
   {
    "note": "First actual network is a tiny fixed shape: controller + drive + terminal, powered through an energy acceptor.",
    "ids": [
     "ae2:controller",
     "ae2:drive",
     "ae2:terminal",
     "ae2:energy_acceptor",
     "ae2:energy_cell",
     "ae2:charger"
    ]
   },
   {
    "note": "Storage bus is taught immediately after the first terminal - it is how existing chests get absorbed into the network.",
    "ids": [
     "ae2:storage_bus",
     "ae2:import_bus",
     "ae2:export_bus",
     "ae2:interface"
    ]
   },
   {
    "note": "Autocrafting comes last and is a MULTIBLOCK, not a machine: crafting unit plus storage plus co-processing, fed by pattern providers into molecular assemblers.",
    "ids": [
     "ae2:crafting_unit",
     "ae2:1k_crafting_storage",
     "ae2:crafting_accelerator",
     "ae2:pattern_provider",
     "ae2:molecular_assembler",
     "ae2:crafting_terminal"
    ]
   }
  ],
  "tiers": [
   {
    "note": "Storage cell ladder 1k -> 4k -> 16k -> 64k -> 256k, mirrored for fluids. This is the mod's main sink for resources.",
    "ids": [
     "ae2:item_storage_cell_1k",
     "ae2:item_storage_cell_4k",
     "ae2:item_storage_cell_16k",
     "ae2:item_storage_cell_64k",
     "ae2:item_storage_cell_256k",
     "ae2:fluid_storage_cell_1k",
     "ae2:fluid_storage_cell_4k",
     "ae2:fluid_storage_cell_16k",
     "ae2:fluid_storage_cell_64k",
     "ae2:fluid_storage_cell_256k"
    ]
   },
   {
    "note": "Crafting storage ladder 1k -> 4k -> 16k -> 64k -> 256k governs how many parallel crafts a CPU can hold.",
    "ids": [
     "ae2:1k_crafting_storage",
     "ae2:4k_crafting_storage",
     "ae2:16k_crafting_storage",
     "ae2:64k_crafting_storage",
     "ae2:256k_crafting_storage"
    ]
   },
   {
    "note": "Processor ladder: printed part -> finished processor, in three flavours, all through the inscriber.",
    "ids": [
     "ae2:printed_logic_processor",
     "ae2:printed_calculation_processor",
     "ae2:printed_engineering_processor",
