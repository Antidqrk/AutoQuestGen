     "industrialforegoing:advanced_black_hole_tank",
     "industrialforegoing:supreme_black_hole_tank"
    ]
   }
  ],
  "gates": [
   {
    "note": "Plastic gates literally everything - it is the mod's hard bottleneck and the reason a latex farm comes before any interesting machine.",
    "ids": [
     "industrialforegoing:plastic",
     "industrialforegoing:latex_processing_unit"
    ]
   },
   {
    "note": "Laser drill needs a fluid laser base AND a coloured lens matched to the target ore; without the lens it produces nothing useful.",
    "ids": [
