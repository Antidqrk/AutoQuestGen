 "human_notes": {
  "order": [
   {
    "note": "Latex is the true step one. Fluid extractors on logs produce it, and everything else waits on that.",
    "ids": [
     "industrialforegoing:fluid_extractor",
     "industrialforegoing:latex_bucket",
     "industrialforegoing:latex_block"
    ]
   },
   {
    "note": "Latex plus water in the latex processing unit makes the plastic that gates every machine frame.",
    "ids": [
     "industrialforegoing:latex_processing_unit",
     "industrialforegoing:plastic"
    ]
   },
   {
    "note": "Guides advise skipping straight past the lowest frame tier where the modpack allows it, rather than building one of each.",
    "ids": [
     "industrialforegoing:machine_frame_pity",
     "industrialforegoing:machine_frame_simple"
    ]
   }
  ],
  "tiers": [
   {
    "note": "MACHINE FRAME ladder is the mod's spine: pity -> simple -> advanced -> supreme. Each machine demands a specific frame tier, so the frame is the real progression currency.",
    "ids": [
     "industrialforegoing:machine_frame_pity",
     "industrialforegoing:machine_frame_simple",
     "industrialforegoing:machine_frame_advanced",
     "industrialforegoing:machine_frame_supreme"
    ]
   },
   {
    "note": "Black hole storage ladder mirrors the frame ladder, for items and fluids.",
    "ids": [
     "industrialforegoing:pity_black_hole_unit",
