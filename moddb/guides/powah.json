     "powah:furnator_starter",
     "powah:furnator_nitro",
     "powah:solar_panel_starter",
     "powah:solar_panel_nitro"
    ]
   },
   {
    "note": "Crystal ladder is the gating material for the upper tiers: blazing -> niotic -> spirited -> nitro.",
    "ids": [
     "powah:crystal_blazing",
     "powah:crystal_niotic",
     "powah:crystal_spirited",
     "powah:crystal_nitro"
    ]
   },
   {
    "note": "Wireless energy also tiers seven ways, via ender cells and ender gates.",
