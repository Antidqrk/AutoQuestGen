 "human_notes": {
  "order": [
   {
    "note": "Two utility items come before any generator: the wrench to configure machines and the book to look recipes up.",
    "ids": [
     "powah:wrench",
     "powah:book"
    ]
   },
   {
    "note": "Starter-tier burn generators are the entry point, then energy cells for storage, then cabling.",
    "ids": [
     "powah:furnator_starter",
     "powah:magmator_starter",
     "powah:energy_cell_starter",
     "powah:energy_cable_starter"
    ]
   },
   {
    "note": "Energizing rods plus an orb are the crafting engine that makes the higher-tier crystals, so they are built early despite looking optional.",
    "ids": [
     "powah:energizing_rod_starter",
     "powah:energizing_rod_basic",
     "powah:energizing_orb"
    ]
   }
  ],
  "tiers": [
   {
    "note": "SEVEN-STEP LADDER, named explicitly and applied to nearly every block in the mod. This is the single most important fact about Powah and it is stated outright.",
    "ids": [
     "powah:energy_cell_starter",
     "powah:energy_cell_basic",
     "powah:energy_cell_hardened",
     "powah:energy_cell_blazing",
     "powah:energy_cell_niotic",
     "powah:energy_cell_spirited",
     "powah:energy_cell_nitro"
    ]
   },
   {
    "note": "The same seven tiers repeat across every generator family - reactors, thermo generators, magmators, furnators and solar panels.",
    "ids": [
     "powah:reactor_starter",
     "powah:reactor_basic",
