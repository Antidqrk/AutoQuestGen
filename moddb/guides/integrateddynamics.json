 "human_notes": {
  "order": [
   {
    "note": "Menril is the entry material and it comes from worldgen trees, so the mod starts with finding a biome, not a bench.",
    "ids": [
     "integrateddynamics:menril_log",
     "integrateddynamics:block_menril_resin",
     "integrateddynamics:crystalized_menril_chunk"
    ]
   },
   {
    "note": "Squeezer and drying basin are the explicit first two crafts, and guides stress the drying basin placement matters.",
    "ids": [
     "integrateddynamics:squeezer",
     "integrateddynamics:drying_basin"
    ]
   },
   {
    "note": "Then the network itself: cable, a reader part, a writer part.",
    "ids": [
     "integrateddynamics:cable",
     "integrateddynamics:part_block_reader",
     "integrateddynamics:part_redstone_writer"
    ]
   },
   {
    "note": "The logic programmer and variable cards come last - they are where the mod's actual programming happens.",
    "ids": [
     "integrateddynamics:logic_programmer",
     "integrateddynamics:variable",
     "integrateddynamics:variablestore"
    ]
   }
  ],
  "tiers": [
   {
    "note": "Progression is by part VARIETY, not power tiers: each reader/writer pair opens a new data domain (inventory, machine, fluid, entity, redstone).",
    "ids": [
     "integrateddynamics:part_inventory_reader",
     "integrateddynamics:part_machine_reader",
     "integrateddynamics:part_fluid_reader",
     "integrateddynamics:part_entity_reader",
     "integrateddynamics:part_redstone_reader",
     "integrateddynamics:part_inventory_writer",
     "integrateddynamics:part_machine_writer",
     "integrateddynamics:part_redstone_writer"
    ]
   },
   {
    "note": "Mechanical variants are the throughput upgrade over the hand-cranked originals.",
    "ids": [
     "integrateddynamics:squeezer",
     "integrateddynamics:mechanical_squeezer",
     "integrateddynamics:drying_basin",
     "integrateddynamics:mechanical_drying_basin"
    ]
   }
  ],
  "gates": [
   {
    "note": "Nothing in the network works without crystalized menril chunks, which require the squeezer/basin pair first.",
    "ids": [
     "integrateddynamics:crystalized_menril_chunk",
     "integrateddynamics:squeezer",
     "integrateddynamics:drying_basin"
    ]
   },
   {
    "note": "Readers produce values that are useless until a logic programmer writes them onto a variable card.",
    "ids": [
     "integrateddynamics:logic_programmer",
     "integrateddynamics:variable",
