 "human_notes": {
  "order": [
   {
    "note": "Controller first, always. It is described as the thing that both defines the network and powers it.",
    "ids": [
     "refinedstorage:controller",
     "refinedstorage:cable"
    ]
   },
   {
    "note": "A nether trip is an unavoidable early step: nether quartz smelts into silicon, and silicon plus iron becomes the quartz enriched iron that every recipe needs.",
    "ids": [
     "refinedstorage:silicon",
     "refinedstorage:quartz_enriched_iron",
     "refinedstorage:basic_processor"
    ]
   },
   {
    "note": "Then disk drive plus a disk for capacity, then a grid for access. Guides stress the grid is the human interface, distinct from storage.",
    "ids": [
     "refinedstorage:disk_drive",
     "refinedstorage:1k_storage_disk",
     "refinedstorage:grid"
    ]
   },
   {
    "note": "IO parts are taught as one group - guides literally call it 'Refined Storage's I/O'.",
    "ids": [
     "refinedstorage:importer",
     "refinedstorage:exporter",
     "refinedstorage:constructor",
     "refinedstorage:destructor",
     "refinedstorage:external_storage"
    ]
   },
   {
    "note": "Autocrafting last: pattern grid to write patterns, crafter to execute them.",
    "ids": [
     "refinedstorage:pattern_grid",
     "refinedstorage:crafter",
     "refinedstorage:crafter_manager",
     "refinedstorage:crafting_grid"
    ]
   }
  ],
  "tiers": [
   {
    "note": "Processor ladder basic -> improved -> advanced, each with a raw form that must be smelted. This is RS's equivalent of AE2's processor line.",
    "ids": [
     "refinedstorage:raw_basic_processor",
     "refinedstorage:basic_processor",
     "refinedstorage:raw_improved_processor",
     "refinedstorage:improved_processor",
     "refinedstorage:raw_advanced_processor",
     "refinedstorage:advanced_processor"
    ]
   },
   {
    "note": "Storage disk ladder 1k -> 4k -> 16k -> 64k, with a parallel fluid line.",
    "ids": [
     "refinedstorage:1k_storage_disk",
     "refinedstorage:4k_storage_disk",
     "refinedstorage:16k_storage_disk",
     "refinedstorage:64k_storage_disk",
     "refinedstorage:64k_fluid_storage_disk",
     "refinedstorage:256k_fluid_storage_disk",
     "refinedstorage:1024k_fluid_storage_disk"
    ]
   },
   {
    "note": "Grid ladder by function rather than power: grid -> crafting grid -> pattern grid -> fluid grid.",
    "ids": [
     "refinedstorage:grid",
     "refinedstorage:crafting_grid",
     "refinedstorage:pattern_grid",
     "refinedstorage:fluid_grid"
    ]
   }
  ],
  "gates": [
   {
    "note": "Wireless is a three-item gate, not one block: transmitter plus receiver plus a network card to pair them.",
    "ids": [
     "refinedstorage:network_transmitter",
     "refinedstorage:network_receiver",
     "refinedstorage:network_card",
     "refinedstorage:wireless_transmitter"
    ]
   },
   {
    "note": "Constructor and destructor need cores to do anything, which is an easily-missed second craft.",
    "ids": [
     "refinedstorage:construction_core",
     "refinedstorage:destruction_core",
     "refinedstorage:constructor",
     "refinedstorage:destructor"
    ]
   }
  ],
  "traps": [
   {
    "note": "Guides warn that the wireless crafting grid is an ADD-ON, not base Refined Storage, so players hunt for a recipe that does not exist in the base mod.",
    "ids": [
     "refinedstorage:wireless_grid",
     "refinedstorage:crafting_grid"
    ]
   }
  ],
  "signature": [
   {
    "note": "RS is pitched explicitly as the no-channel alternative to AE2 - the selling point is that the network just works without an infrastructure puzzle.",
    "ids": [
     "refinedstorage:controller",
     "refinedstorage:grid",
     "refinedstorage:disk_drive"
    ]
   },
   {
    "note": "Autocrafting via crafter is the payoff every RS guide builds toward.",
    "ids": [
     "refinedstorage:crafter",
     "refinedstorage:pattern_grid",
     "refinedstorage:crafter_manager"
    ]
   }
  ]
 },
